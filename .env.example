# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_51...your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_51...your_secret_key_here

# Firebase Configuration
# Get these from your Firebase project settings
FIREBASE_API_KEY=AIza...your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_APP_ID=1:123456789:android:your_app_id_here
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Note: Never commit your actual .env file to version control
# Copy this file to .env and add your actual keys